### URL: https://www-dev.springfield.moz.works/features/password-manager

# HTML page title
password-manager-free-password-manager = Bezmaksas paroļu pārvaldnieks
# HTML page description
password-manager-firefox-password-manager-saves-all = { -brand-name-firefox } Paroļu pārvaldnieks saglabā visas paroles vienuviet, lai varētu automātiski pieteikties vietnēs vai izgūt saglabātās paroles.
password-manager-firefox-securely-stores-your = { -brand-name-firefox } droši glabā jūsu lietotājvārdus un paroles tīmekļa vietņu piekļuvei, automātiski aizpilda tos jūsu vietā nākamajā reizē, kad apmeklēsiet tīmekļa vietni, un ļauj pārvaldīt saglabātos pieteikšanās datus, izmantojot iebūvēto paroļu pārvaldības funkciju.
# Variables:
#   $fxa (url) = link to https://www.mozilla.org/accounts/
password-manager-with-a-free-mozilla-account-v2 = Ar <a { $fxa }>bezmaksas { -brand-name-mozilla-account } </a> varat droši sinhronizēt savas paroles visās savās ierīcēs. Varat arī piekļūt visiem citiem { -brand-name-mozilla } produktiem, kas ievēro privātumu.
password-manager-password-autofill-for-easy-logins = Paroļu automātiskā aizpilde ērtai pieteikšanās iespējai
password-manager-firefox-can-automatically-fill-in = { -brand-name-firefox } var automātiski aizpildīt jūsu saglabāto lietotājvārdu un paroli. Ja jums ir vairāki pieteikšanās dati vienai vietnei, varat vienkārši atlasīt vēlamo kontu, un mēs to paveiksim.
# Used as an accessible text alternative for an image
password-manager-image-of-a-websites-login-form = Tīmekļa vietnes pieteikšanās veidlapas attēls ar { -brand-name-firefox }, kurā redzami vairāki saglabāti konti, no kuriem izvēlēties, piesakoties.
password-manager-import-passwords = Ievietot paroles
password-manager-you-can-use-the-import-wizard = Izmantojot ievietošanas vedni, varat pavisam vienkārši (gluži kā ar burvju mājienu) ievietot pārlūkprogrammās Chrome, Edge, Safari vai citās pārlūkprogrammās saglabātos lietotājvārdus un paroles. Izvēlnē atlasiet “Paroles” un pēc tam lapas “Lietotājvārdi un paroles” apakšdaļā noklikšķiniet uz “ievietot tās pārlūkprogrammā { -brand-name-firefox }”.
# Used as an accessible text alternative for an image
password-manager-image-of-the-firefox-import-wizard = { -brand-name-firefox } ievietošanas vedņa dialoglodziņš ar iespējām ievietot iestatījumus un datus no citiem pārlūkiem.
password-manager-no-more-reusing-your-passwords = Vairs nebūs atkārtoti jāizmanto jūsu paroles
# Variables:
#   $attrs (url) = link to https://support.mozilla.org/kb/how-generate-secure-password-firefox
password-manager-have-firefox-create-a-strong-unique = Liec { -brand-name-firefox } <a { $attrs }>izveidot spēcīgu, neatkārtojamu paroli</a> katram pieteikšanās vienumam tīmeklī — tādā veidā, ja kāda no parolēm tiek uzlauzta drošības pārkāpuma dēļ, tas ietekmēs tikai šo vienu kontu, nevis vairākus!
# Used as an accessible text alternative for an image
password-manager-image-of-a-websites-sign-up-form = Tīmekļa vietnes reģistrācijas veidlapa, kurā { -brand-name-firefox } iesaka drošu paroli un automātiski saglabā to turpmākai lietošanai.
password-manager-password-security-alerts = Paroļu drošības brīdinājumi
# Variables:
#   $attrs (url) = link to https://support.mozilla.org/kb/firefox-password-manager-alerts-breached-websites
# "Lambo" is American slang for a Lamborghini sports car. You can spell out the full name or substitute a similarly extravagant item.
password-manager-firefox-alerts-you-if-a-password-has = { -brand-name-firefox } <a { $attrs }>brīdina, ja datu noplūdē ir atklāta jūsu parole</a>, lai jūs varētu to nomainīt, pirms hakeri pagūst, piemēram, ar jūsu maksājumu karti iznomāt Lamborghini.
# Used as an accessible text alternative for an image
password-manager-image-of-the-firefox-password-manager = Attēls, kurā redzams { -brand-name-firefox } paroļu pārvaldnieks ar brīdinājuma ziņojumu “Šī parole ir izmantota citā kontā, kas, iespējams, ir bijis datu noplūdes upuris. Atkārtota piekļuves datu izmantošana apdraud visus jūsu kontus. Mainiet šo paroli.”
