cookie-settings-page-title = Çərəz tənzimləmələri
cookie-settings-page-desc = Bu səhifə { -brand-name-mozilla } tərəfindən istifadə edilə bilən müxtəlif Çərəz növlərini təsvir edir və { -brand-name-mozilla }-nın hansı növ məlumatları toplamasına razılıq verdiyinizə nəzarət imkanı verir.
cookie-settings-breadcrumb-link = Əvvəlki səhifə
cookie-settings-explainer = Çərəzlər saytı ziyarət etdiyiniz zaman kompüterinizə və ya cihazınıza saxlanılan, müəyyən məlumat parçalarını ehtiva edən kiçik fayllardır. { -brand-name-mozilla } Çərəzlərdən saytlarımızın işləməsinə kömək etmək, həmçinin ziyarət etdiyiniz səhifələr kimi saytlarımızdan necə istifadə etdiyiniz və onlarla qarşılıqlı əlaqədə olduğunuz barədə məlumat toplamaq üçün istifadə edir.
cookie-settings-page-intro-v2 = Bu səhifə { -brand-name-mozilla } tərəfindən istifadə edilə bilən müxtəlif Çərəz növlərini və piksel teqləri, veb mayakları, şəffaf GIF-lər, JavaScript və yerli yaddaş kimi oxşar texnologiyaları (bundan sonra “Çərəzlər”) təsvir edir və { -brand-name-mozilla }-nın hansı növ məlumatları toplamasına razılıq verdiyinizə nəzarət imkanı verir.
cookie-settings-how-mozilla-heading = { -brand-name-mozilla } Çərəzlərdən necə istifadə edir
cookie-settings-how-does-mozilla-use-subheading = { -brand-name-mozilla } bu məlumatlardan necə istifadə edir?
cookie-settings-save-changes = Dəyişiklikləri Saxla
cookie-settings-your-cookie-settings-have = Çərəz tənzimləmələriniz yeniləndi.
cookie-settings-i-agree = Razıyam
cookie-settings-i-do-not-agree = Razı Deyiləm
cookie-settings-turn-on-javascript = Çərəz tənzimləmələrinizi yeniləmək üçün JavaScript-i aktivləşdirin.

## Necessary cookies section

cookie-settings-category-necessary-heading = Zəruri
cookie-settings-category-necessary-what-are-subheading = Zəruri Çərəzlər Nədir?
cookie-settings-category-necessary-what-are-desc = Bu texnologiyalar saytın təhlükəsiz sahəsinə daxil olmaq və ya onlayn alış-veriş səbətinə elementlər əlavə etmək kimi əsas sayt özəlliklərini dəstəkləmək üçün tələb olunur və söndürülə bilməz.
cookie-settings-category-necessary-how-does-desc-v2 = { -brand-name-mozilla } Zəruri Çərəzlərdən yalnız { -brand-name-mozilla-account } ilə daxil olmaq və ya ödəniş zamanı proqram abunəliyi almaq kimi əsas sayt özəlliklərini təmin etmək üçün istifadə edir. Bu texnologiyalar olmadan əsas sayt özəllikləri işləməyə bilər.

## Preference cookies section

cookie-settings-category-preference-heading = Nizamlamalar
cookie-settings-category-preference-what-are-subheading = Nizamlama Çərəzləri Nədir?
cookie-settings-category-preference-what-are-desc = Bu texnologiyalar sayta əvvəlki səfəriniz zamanı etdiyiniz seçimləri xatırlamaq üçün istifadə olunur. Məsələn, hansı dildə oxumağa üstünlük verdiyiniz və ya hansı rəng mövzusunun sevimliniz olduğu bura aid edilə bilər.
cookie-settings-category-preference-how-does-desc = { -brand-name-mozilla } Nizamlama Çərəzlərindən saytlarımızı ziyarət edərkən seçimlərinizə hörmət etmək və təcrübənizi yaxşılaşdırmaq üçün istifadə edir. Onlar analitika məqsədləri üçün istifadə edilmir. Nizamlama Çərəzləri özəllikləri Zəruri Çərəzlərə bənzər şəkildə dəstəkləyir, lakin sayt onlarsız da fəaliyyət göstərə bilər. Buna görə də onların istifadəsindən imtina etməyi seçə bilərsiniz.

## Analytics cookies section

cookie-settings-category-analytics-heading = Analitika
cookie-settings-category-analytics-what-are-subheading = Analitika Çərəzləri Nədir?
cookie-settings-category-analytics-what-are-desc = Bu texnologiyalar insanların saytlardan necə istifadə etdiyi, məsələn, ziyarət edilən səhifələr, kliklənən keçidlər və digər hansı saytlardan gəlindiyi barədə məlumat toplayır.
cookie-settings-category-analytics-how-does-desc = { -brand-name-mozilla } analitika məlumatlarından istifadəçilərin saytlarımızla necə qarşılıqlı əlaqədə olduğunu anlamaq üçün istifadə edir ki, biz onları təkmilləşdirə və yaranan hər hansı problemi həll edə bilək. Biz həmçinin Çərəzlərdən, cihaz məlumatlarından və IP ünvanlarından əldə edilən məlumatlardan istifadəçilərin məhsullarımız, xidmətlərimiz, ünsiyyətlərimiz, saytlarımız, onlayn kampaniyalarımız, cihazlarımız və digər platformalarımızla necə əlaqə qurduğunu anlamaq üçün istifadə edə bilərik. Biz analitika məlumatlarını yalnız sizin razılığınızla toplayacaq və Analitika Çərəzlərini quracağıq.

## Privacy section

cookie-settings-privacy-heading = Məxfilik bildirişimiz
cookie-settings-privacy-desc = Saytlarımızı ziyarət etdiyiniz zaman { -brand-name-mozilla }-nın topladığı müxtəlif növ məlumatlar haqqında daha ətraflı məlumat üçün aşağıda məxfilik bildirişimizə keçid tapa bilərsiniz.
cookie-settings-privacy-policy-link = Məxfilik Bildirişi
