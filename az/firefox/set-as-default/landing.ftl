### URL: https://www-dev.springfield.moz.works/landing/set-as-default/

# HTML page title
set-as-default-landing-make-firefox-your-default = { -brand-name-firefox }-u əsas səyyahınız edin
# HTML page description
set-as-default-landing-choose-the-browser = Məxfiliyinizi qoruyan səyyahı seçin. { -brand-name-firefox }-u əsas səyyahınız olaraq qurun.
set-as-default-landing-thanks-for-using-the = Ən son { -brand-name-firefox } səyyahını işlətdiyiniz üçün təşəkkürlər. { -brand-name-firefox }-u seçməklə özünüz və hər kəs üçün daha yaxşı bir internetə dəstək olursunuz. İndi özünüzü qorumaq üçün növbəti addımı atın.
set-as-default-landing-make-sure-youre-protected = İnternetə hər daxil olduqda qorunduğunuzdan əmin olun
set-as-default-landing-you-should-get = Necə səyahət edəcəyiniz barədə söz haqqınız olmalıdır
set-as-default-landing-if-you-recently = Bu yaxınlarda kompüterinizi yeniləmisinizsə, tənzimləmələriniz dəyişmiş ola bilər. { -brand-name-firefox } ilə internetə hər daxil olduqda azad və açıq interneti dəstəkləyin.
set-as-default-landing-choose-automatic-privacy = Avtomatik məxfiliyi seçin
set-as-default-landing-companies-keep-finding = Şirkətlər şəxsi məlumatlarınızı ələ keçirmək üçün daim yeni yollar axtarırlar. { -brand-name-firefox } sizi qorumaq üçün yeni yollar tapmaq missiyasını daşıyan səyyahdır.
set-as-default-landing-choose-freedom-on-every = Hər cihazda azadlığı seçin
set-as-default-landing-firefox-is-fast-and = { -brand-name-firefox } { -brand-name-windows }, { -brand-name-ios }, { -brand-name-android }, { -brand-name-linux } üzərində… və onların hamısında sürətli və təhlükəsizdir. Sizin yerinizə qərarlar verilməsi əvəzinə, səyyah və cihaz seçimlərinə layiqsiniz.
set-as-default-landing-choose-corporate-independence = Korporativ müstəqilliyi seçin
set-as-default-landing-firefox-is-the-only = { -brand-name-firefox } yeganə böyük müstəqil səyyahdır. { -brand-name-chrome }, { -brand-name-edge } və { -brand-name-brave } hamısı { -brand-name-google } kodu üzərində qurulub, bu da { -brand-name-google }-a internet üzərində daha çox nəzarət vermək deməkdir.
