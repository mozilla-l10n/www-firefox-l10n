### URL: https://www-dev.springfield.moz.works/get/

# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-language-not-available = { $partner } tərəfindən təqdim edilən bu { -brand-name-firefox } endirməsi sizin dilinizdə mövcud deyil. Aşağıdakı düymədən istifadə edərək yenə də { -brand-name-firefox }-u endirə bilərsiniz.
# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-device-not-available = { $partner } tərəfindən təqdim edilən bu { -brand-name-firefox } endirməsi cihazınız üçün mövcud deyil. Aşağıdakı düymədən istifadə edərək yenə də { -brand-name-firefox }-u endirə bilərsiniz.
# firefox.com is a web address. Don’t translate it.
partner-download-already-using-firefox = Siz artıq { -brand-name-firefox } işlədirsiniz. Yenilikləri görmək üçün firefox.com saytına davam edin.
# firefox.com is a web address. Don’t translate it.
partner-download-continue = firefox.com saytına davam edin
# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-link-visit = { $partner } saytına baş çəkin
# Button text for a link to a company’s page.
partner-download-link-learn-more = Ətraflı öyrən
