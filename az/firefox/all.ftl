firefox-all-learn-about-firefox = { -brand-name-firefox } səyyahları haqqında öyrənin
firefox-all-the-standard-firefox = Standart { -brand-name-firefox } səyyahı — sürətli və məxfi. Hansı { -brand-name-firefox }-u seçəcəyinizdən əmin deyilsinizsə, bunu seçin.
firefox-all-get-a-sneak-peek-at = Ən son { -brand-name-firefox } səyyah özəllikləri çıxmamışdan əvvəl onlara nəzər salın.
firefox-all-test-your-sites-against = İlkin vəziyyətdə aktiv olan güclü, çevik DevTools ilə saytlarınızı tezliklə çıxacaq { -brand-name-firefox } səyyah özəlliklərinə qarşı yoxlayın.
firefox-all-count-on-stability-and = Müəssisələr üçün qurulmuş bu { -brand-name-firefox } səyyahı ilə sabitliyə və istifadə asanlığına arxayın olun.
firefox-all-the-familiar-firefox-browser = Təşkilatların sərt təhlükəsizlik, idarəetmə və uyğunluq tələblərinə cavab verməsinə kömək etmək üçün admin konsolu ilə birlikdə əlavə təhlükəsizlik nəzarətinə malik tanış { -brand-name-firefox } səyyahı.
firefox-all-windows-installers-for = { -brand-name-firefox-browser } səyyahının tənzimlənməsini, yerləşdirilməsini və idarə olunmasını sadələşdirən korporativ İT üçün Windows quraşdırıcıları.
firefox-all-arm64-installers = ARM64/AArch64 quraşdırıcılar
firefox-all-arm64-installers-optimized-v2 = Windows və Linux kompüterləri üçün optimallaşdırılmış ARM64/AArch64 quraşdırıcıları.
firefox-all-testflight = TestFlight ilə iOS üçün { -brand-name-firefox }-u test etmək üçün qeydiyyatdan keçin
