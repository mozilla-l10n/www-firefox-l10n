# Obsolete string (expires 16-09-2025)
features-adblocker-meta-title = Reklam Əngəlləyicilər Haqqında - { -brand-name-firefox }
# HTML page description
features-adblocker-meta-desc = Reklam əngəlləyicilərin necə işlədiyini, sizin üçün nə edə biləcəyini və { -brand-name-firefox }-un sizi izləyicilərdən və çərəzlərdən necə qoruduğunu öyrənin.
features-adblocker-the-ad-blocker-a-tool = Reklam əngəlləyicisi – fərdiləşdirilmiş və diqqətli səyahət təcrübəsi üçün alət.
features-adblocker-in-todays-digital-world = Bugünkü rəqəmsal dünyada internet qarışıq və sıx ola bilər. Reklam əngəlləyiciləri səyahət təcrübənizə nəzarəti sizə verən və ekranınızda nəyin görünəcəyinə qərar verməyə imkan verən güclü alətlərdir.
features-adblocker-ad-blockers-work = Reklam əngəlləyiciləri iki əsas yolla işləyir: reklamlar kimi məzmunun yüklənməsinin qarşısını almaqla və həmin elementləri saxlayan veb-saytların hissələrini əngəlləməklə. Bura video reklamlar, internetdə sizi izləyən fərdiləşdirilmiş reklamlar və hətta üçüncü tərəf izləyiciləri daxil ola bilər.
# Variables:
#   $firefox (url) - link to https://www.firefox.com/
#   $addons (url) - link to https://blog.mozilla.org/firefox/ad-blocker-roundup-5-adblockers-that-improve-your-internet-experience/
features-adblocker-using-an-adblocker = Reklam əngəlləyicidən istifadə etmək sadədir. Bir çox etibarlı seçim səyyah əlavələri kimi mövcuddur və bu da ehtiyaclarınıza uyğun həlli tapmağı asanlaşdırır. Məsələn, <a href="{ $firefox }">{ -brand-name-firefox }</a> məxfiliyinizə hörmət edərkən səyahət təcrübənizi yaxşılaşdırmaq üçün hazırlanmış <a href="{ $addons }">təsdiqlənmiş uzantıların siyahısını</a> təqdim edir.
features-adblocker-finding-the-right = Sizin Üçün Doğru Reklam Əngəlləyicisinin Tapılması
features-adblocker-there-are-many = Kəşf ediləcək çoxlu reklam əngəlləmə alətləri var və hər biri müxtəlif seçimlərə uyğun özəlliklər təklif edir. Sizin üçün doğru olanı tapmaq istəklərinizdən və səyahət vərdişlərinizdən asılıdır. Nəzərə almalı olduğunuz bir neçə məsləhət:
features-adblocker-tip-1 = <strong>Reklamların Əngəllənməsi:</strong> Yalnız reklamları əngəlləmək istəyirsinizsə, sadə və yüngül bir seçim seçin.
features-adblocker-tip-2 = <strong>Məxfilik Qayğıları:</strong> İzləyicilərdən narahatsınızsa, daxili məxfilik özəllikləri olan reklam əngəlləyicisi axtarın.
features-adblocker-tip-3 = <strong>Fərdiləşdirmə:</strong> Bəzi reklam əngəlləyicilər xüsusi saytları ağ siyahıya salmaq və ya xüsusi elementləri əngəlləmək üçün dəqiq tənzimləməyə imkan verir.
features-adblocker-tip-4 = <strong>Cihaz Uyğunluğu:</strong> Ona masaüstü, mobil və ya hər ikisi üçün ehtiyacınız olub-olmadığını düşünün.
features-adblocker-tip-5 = <strong>Zərərverici Proqram Əngəlləməsi:</strong> Bəzi reklam əngəlləyicilər zərərli reklamlardan qoruyur (məsələn, AdGuard).
features-adblocker-tip-6 = <strong>Valideyn Nəzarəti:</strong> Uyğunsuz məzmunu əngəlləmək istəyirsinizsə faydalıdır.
features-adblocker-its-important-to-note = Nəzərə almaq vacibdir ki, bəzi veb-saytlar məzmunu yükləmək və ya funksionallıq təmin etmək üçün reklamlara arxalanır. Reklamların əngəllənməsi bəzi özəlliklərin pozulmasına, məsələn, videoların oynadılmamasına və ya giriş seçimlərinin işləməməsinə səbəb ola bilər. Müntəzəm olaraq yenilənən bir reklam əngəlləyici seçin və bir reklam əngəlləyicinin ciddi problemlərə səbəb olduğunu görsəniz, məhsuldarlıq və uyğunluğun daha yaxşı balansını tapmaq üçün başqasını yoxlayın.
features-adblocker-enhanced-privacy = { -brand-name-firefox } ilə Təkmilləşdirilmiş Məxfilik və Məhsuldarlıq
features-adblocker-beyond-ad-blockers = Reklam əngəlləyicilərdən əlavə, { -brand-name-firefox } səyahətinizə daha da çox nəzarət imkanı verən daxili özəllikləri ehtiva edir. Bu alətlər təcrübənizi fərdiləşdirməyə imkan verərkən məxfiliyinizi qorumağa kömək edir:
features-adblocker-tool-1 = <strong>Standart Rejim:</strong> Rahat sayt funksionallığını qoruyaraq ümumi izləyiciləri əngəlləyən balanslaşdırılmış seçim.
features-adblocker-tool-2 = <strong>Sərt Rejim:</strong> Daha çox izləyici və çərəzləri əngəlləməklə daha güclü məxfilik mühafizəsi istəyən istifadəçilər üçün idealdır. Qeyd edək ki, bəzi saytlar bu rejimdə düzəlişlər tələb edə bilər.
features-adblocker-tool-3 = <strong>Xüsusi Rejim:</strong> Tam nəzarət istəyənlər üçün Xüsusi rejim çərəzlərdən izləyicilərə və daha çoxuna qədər nəyi əngəlləyəcəyinizi seçməyə imkan verir.
features-adblocker-to-adjust = Bu tənzimləmələri dəyişmək üçün istənilən veb-səhifədə ünvan sətrinin solundakı qalxan işarəsinə klikləyin və “Mühafizə Tənzimləmələri”ni seçin. Bu, sizin üçün uyğun mühafizə səviyyəsini seçə biləcəyiniz bir menyu açacaq.
features-adblocker-why-use = Niyə Reklam Əngəlləyicidən İstifadə Edilməlidir?
features-adblocker-ad-blockers-do-more = Reklam əngəlləyiciləri reklamları idarə etməkdən daha çoxunu edir – onlar lazımsız məzmunu azaltmaqla səyahət sürətinizi və təhlükəsizliyinizi artıra bilər. Onlar sizə ən vacib olan şeyə diqqət yetirməyə imkan verərək xüsusi, diqqət yayındırmayan veb təcrübəsi yaratmaq üçün güc verir.
# Variables:
#   $url (url) - link to https://www.firefox.com/
features-adblocker-explore-hundreds = { -brand-name-firefox } üçün mövcud olan yüzlərlə məxfilik yönümlü əlavəni kəşf edin və sizin üçün doğru alətləri tapın. Məxfiliyiniz və məhsuldarlığınız nəzərə alınmaqla hazırlanmış səyyahı təcrübədən keçirmək üçün bu gün <a href="{ $url }">{ -brand-name-firefox }-u endirin</a>.
