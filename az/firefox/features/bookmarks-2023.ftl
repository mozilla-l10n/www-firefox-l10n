### URL: https://www-dev.springfield.moz.works/features/bookmarks/

# page title
bookmark-manager-bookmark-manager = Əlfəcin meneceri
# HTML page description
bookmark-manager-organize-your-bookmarks-with = Əlfəcinlərinizi qovluqlar və etiketlərlə təşkil edin.
# Variables:
#   $sync (url) - link to https://www.firefox.com/features/sync/
bookmark-manager-bookmarks-are-links-you-save = Əlfəcinlər internetdə sevimli yerlərinizə tez və asanlıqla qayıda bilməyiniz üçün səyyahınızda saxladığınız keçidlərdir. { -brand-name-firefox } bütün saxlanılan keçidlərinizi təşkil etmək, axtarmaq, yeniləmək və <a { $sync }>bütün cihazlarınız arasında sinxronlaşdırmaq</a> üçün rahat əlfəcin menecerini ehtiva edir.
bookmark-manager-organize-your-boomarks-into = Əlfəcinlərinizi axtarıla bilən qovluqlarda təşkil edin
bookmark-manager-collect-your-bookmarks-in-folders = Əlfəcinlərinizi qovluqlarda toplayın və onları daha ətraflı məlumatlarla etiketləyin. Siz həmçinin ehtiyacınız olanları tez tapmaq üçün əlfəcinlərinizi çeşidləyə bilərsiniz.
bookmark-manager-easily-import-bookmarks = Əlfəcinləri asanlıqla idxal edin
bookmark-manager-you-can-import-your-bookmarks = { -brand-name-firefox }-un idxal sehrbazı ilə əlfəcinlərinizi Chrome, Safari və ya Edge-dən idxal edə bilərsiniz. Sadəcə Əlfəcinlər > Əlfəcinləri İdarə Et klikləyin və sonra “İdxal və Yedəkləmə” seçin.
# Used as an accessible text alternative for an image
bookmark-manager-image-of-the-firefox-import-wizard = Digər səyyahlardan tənzimləmələri və məlumatları idxal etmək seçimlərini göstərən { -brand-name-firefox } idxal sehrbazı dialoqunun şəkli.
bookmark-manager-bookmarks-toolbar = Əlfəcinlər paneli
bookmark-manager-get-quick-access-to-your = { -brand-name-firefox }-un yuxarı hissəsindəki menyuda sevimli əlfəcinlərinizə sürətli giriş əldə edin və ya onları panelinizə sabitləyin.
# Used as an accessible text alternative for an image
bookmark-manager-image-of-firefox-showing-a-collection = Səyyah pəncərəsinin yuxarısındakı paneldə əlfəcinlər toplusunu göstərən { -brand-name-firefox } şəkli.
