# HTML page title
features-translate-translate-a-webpage-with-firefox = { -brand-name-firefox } ilə veb-səhifəni tərcümə edin
features-translate-translate-the-web = İnterneti tərcümə edin
# HTML page description
features-translate-firefox-translations-is-a-built-in-v2 = { -brand-name-firefox-translations } internetdə sevimli dilinizdə asanlıqla səyahət etməyə imkan verən daxili tərcümə özəlliyidir. { -brand-name-firefox }-dakı bu özəlliyin necə işlədiyi və { -brand-name-mozilla }-nın tərcümə etdiyiniz məlumatları necə məxfi saxladığı haqqında ətraflı öyrənin.
features-translate-one-of-the-best-things-about = İnternetin ən yaxşı cəhətlərindən biri odur ki, biz bütün dünyadakı məzmuna çıxış əldə edə bilirik. İstər xəbər məqalələri, istər bloqlar, istərsə də ən son texnoloji cihazınızın icmalı olsun, bunların hamısını sonsuz görünən internetdə tapa bilərsiniz. { -brand-name-firefox }-un ən son tərcümə özəlliyi ilə bu alət veb-səhifəni real vaxt rejimində davamlı olaraq tərcümə edəcək.
features-translate-while-other-browsers-rely-on-v2 = Digər səyyahlar bulud xidmətlərinə arxalandığı halda, { -brand-name-firefox-translations } dil modelləri istifadəçinin səyyahına endirilir və tərcümələr yerli olaraq icra edilir, beləliklə { -brand-name-mozilla } hansı veb-səhifələri tərcümə etdiyinizi qeydə almır.
features-translate-when-you-translate-a-webpage = Veb-səhifəni tərcümə etdikdə o, məxfi qalır
features-translate-when-your-translations-are = Tərcümələriniz yerli olaraq işləndikdə, seçdiyiniz cihazdan heç bir məlumat cihazınızı tərk etmir və ya tərcümə üçün bulud xidmətlərinə arxalanmır. Bu o deməkdir ki, { -brand-name-mozilla } hansı veb-səhifəni tərcümə etdiyinizi bilmir və bu da tərcümə özəlliyimizi digər tərcümə alətləri ilə müqayisədə fərqləndirir.
features-translate-what-languages-are-currently = Hazırda hansı dillər dəstəklənir?
# This is followed by a localized list of supported languages
features-translate-the-languages-below-are-what-v2 = Aşağıdakı dillər hazırda { -brand-name-firefox-translations } özəlliyi tərəfindən dəstəklənir:
features-translate-and-more-languages-are-in = Və daha çox dil tərtibat mərhələsindədir!
features-translate-firefox-speaks-your-language = { -brand-name-firefox } sizin dilinizdə danışır
# Variables:
#   $download (url) = link to https://www.firefox.com/thanks/
features-translate-the-firefox-translations-feature-v2 = { -brand-name-firefox-translations } özəlliyi { -brand-name-mozilla }-nın internetinizi fərdiləşdirilmiş və daha məxfi saxlamasının başqa bir yoludur. { -brand-name-mozilla } hansı veb-səhifələri tərcümə etdiyinizi izləmir. Dünya üzrə milyonlarla istifadəçisi olan { -brand-name-mozilla } { -brand-name-firefox } işlədənlərin öz şərtləri ilə öyrənmələrini, ünsiyyət qurmalarını, paylaşmalarını və məlumatlı qalmalarını təmin etmək istəyir. <a { $download }>{ -brand-name-firefox }-u endirərək sevimli dilinizdə başlayın.</a>
features-translate-get-started-in-your-preferred = { -brand-name-firefox }-u endirərək sevimli dilinizdə başlayın
