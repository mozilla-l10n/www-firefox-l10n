# page title
features-sync-firefox-browser-sync = { -brand-name-firefox } səyyah sinxronlaşdırması
# HTML page description
features-sync-access-your-firefox-bookmarks = İstənilən cihazdan { -brand-name-firefox } əlfəcinlərinizə, parollarınıza, açıq vərəqlərinizə və daha çoxuna daxil olun.
features-sync-with-firefox-you-can-pick-up-where = { -brand-name-firefox } ilə masaüstü kompüterinizdən mobil telefonunuza və planşetinizə keçdikdə qaldığınız yerdən davam edə bilərsiniz. { -brand-name-firefox } hansı cihazdan istifadə etməyinizdən asılı olmayaraq əlfəcinlərinizi, səyahət tarixçənizi, saxlanılan parollarınızı və daha çoxunu görməyə imkan verir.
#   $fxa (url) = link to https://www.mozilla.org/accounts/
features-sync-sign-up-for-a-free-mozilla-account-v3 = <a { $fxa }>Pulsuz { -brand-name-mozilla-account } üçün qeydiyyatdan keçin</a> və { -brand-name-firefox } və digər { -brand-name-mozilla } məhsullarını istifadə etdiyiniz hər yerdə məlumatlarınızı sinxronlaşdıra biləcəksiniz.
# Variables:
#   $privacy (url) = link to https://www.mozilla.org/privacy/
features-sync-all-your-data-is-encrypted-on-our = Bütün məlumatlarınız serverlərimizdə şifrələnir, buna görə də biz onu oxuya bilmirik – yalnız siz ona daxil ola bilərsiniz. Məlumatlarınızı reklamverənlərə satmırıq, çünki bu, <a href="{ $privacy }">məlumat məxfiliyi vədimizə</a> zidd olardı.
features-sync-send-tabs-from-one-device-to-another = Vərəqləri bir cihazdan digərinə göndərin
features-sync-the-send-tab-feature-in-firefox = { -brand-name-firefox }-dakı Vərəqi Göndər özəlliyi bir cihazdakı { -brand-name-firefox }-dan səhifələri digər cihazlara (məsələn, iPhone, iPad və ya Android cihazı) göndərməyə imkan verir. Telefonunuzda gəzərkən iş masanıza qayıtdıqda oxumaq istədiyiniz bir məqalə tapdınız? Yaxud evə çatanda saxlamaq istədiyiniz işdən vacib bir sənəd? Bəlkə də noutbukunuzda mətbəxdəki planşetinizə göndərmək istədiyiniz resept tapmısınız. Həmin vərəqi göndərin!
# Used as accessible alternative text for an image
features-sync-an-image-of-a-firefox-application = “Vərəqi Cihaza Göndər” seçimini vurğulayan { -brand-name-firefox } tətbiqetmə menyusunun şəkli.
