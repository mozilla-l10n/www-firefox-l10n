### URL: https://www-dev.springfield.moz.works/features/password-manager

# HTML page title
password-manager-free-password-manager = Pulsuz parol meneceri
# HTML page description
password-manager-firefox-password-manager-saves-all = { -brand-name-firefox } Parol Meneceri bütün parollarınızı bir yerdə saxlayır ki, saytlara avtomatik daxil ola və ya saxlanılan parolları əldə edə biləsiniz.
password-manager-firefox-securely-stores-your = { -brand-name-firefox } veb-saytlara daxil olmaq üçün istifadəçi adlarınızı və parollarınızı təhlükəsiz şəkildə saxlayır, növbəti dəfə sayta daxil olduqda onları sizin üçün avtomatik doldurur və daxili parol idarəetmə özəlliyi ilə saxlanılan girişlərinizi idarə etməyə imkan verir.
# Variables:
#   $fxa (url) = link to https://www.mozilla.org/accounts/
password-manager-with-a-free-mozilla-account-v2 = <a { $fxa }>Pulsuz { -brand-name-mozilla-account }</a> ilə parollarınızı bütün cihazlarınızda təhlükəsiz şəkildə sinxronlaşdıra bilərsiniz. Siz həmçinin { -brand-name-mozilla }-nın məxfiliyə hörmət edən digər məhsullarına da daxil ola bilərsiniz.
password-manager-password-autofill-for-easy-logins = Asan giriş üçün parolların avtodoldurulması
password-manager-firefox-can-automatically-fill-in = { -brand-name-firefox } saxlanılan istifadəçi adınızı və parolunuzu avtomatik doldura bilər. Əgər bir sayt üçün birdən çox girişiniz varsa, sadəcə istədiyiniz hesabı seçə bilərsiniz və qalanını biz həll edəcəyik.
# Used as an accessible text alternative for an image
password-manager-image-of-a-websites-login-form = Daxil olarkən seçmək üçün { -brand-name-firefox }-un bir neçə saxlanılmış hesabı göstərdiyi veb-saytın giriş formasının şəkli.
password-manager-import-passwords = Parolları idxal edin
password-manager-you-can-use-the-import-wizard = Chrome, Edge, Safari və ya digər səyyahlarda saxlanılan istifadəçi adlarını və parolları asanlıqla (sehrli şəkildə) idxal etmək üçün idxal sehrbazından istifadə edə bilərsiniz. Menyudan Parolları seçin və sonra Girişlər və Parollar səhifəsinin aşağısındakı “onları { -brand-name-firefox }-a idxal edin” düyməsinə klikləyin.
# Used as an accessible text alternative for an image
password-manager-image-of-the-firefox-import-wizard = Digər səyyahlardan tənzimləmələri və məlumatları idxal etmək seçimlərini göstərən { -brand-name-firefox } idxal sehrbazı dialoqunun şəkli.
password-manager-no-more-reusing-your-passwords = Artıq parollarınızı təkrar istifadə etməyə son
# Variables:
#   $attrs (url) = link to https://support.mozilla.org/kb/how-generate-secure-password-firefox
password-manager-have-firefox-create-a-strong-unique = { -brand-name-firefox }-un internetdəki hər bir girişiniz üçün <a { $attrs }>güclü, unikal parol yaratmasını</a> təmin edin — beləliklə, təhlükəsizlik pozuntusu nəticəsində parollarınızdan biri sındırılsa, bu, digər hesablarınıza deyil, yalnız həmin tək hesaba təsir edəcək.
# Used as an accessible text alternative for an image
password-manager-image-of-a-websites-sign-up-form = { -brand-name-firefox }-un gələcəkdə istifadə üçün avtomatik saxlayacağı güclü parolu təklif etdiyi veb-saytın qeydiyyat formasının şəkli.
password-manager-password-security-alerts = Parol təhlükəsizliyi xəbərdarlıqları
# Variables:
#   $attrs (url) = link to https://support.mozilla.org/kb/firefox-password-manager-alerts-breached-websites
# "Lambo" is American slang for a Lamborghini sports car. You can spell out the full name or substitute a similarly extravagant item.
password-manager-firefox-alerts-you-if-a-password-has = { -brand-name-firefox } məlumat sızmasında <a { $attrs }>parolun aşkar edilib-edilmədiyi barədə sizə xəbərdarlıq edir</a> ki, hakerlərin kredit kartınızla lüks avtomobil icarəyə götürmək kimi bir şey etmək şansı olmadan əvvəl onu dəyişə biləsiniz.
# Used as an accessible text alternative for an image
password-manager-image-of-the-firefox-password-manager = “Bu parol ehtimal ki, məlumat sızmasında olan başqa bir hesabda istifadə edilib. Giriş məlumatlarının təkrar istifadəsi bütün hesablarınızı risk altına qoyur. Bu parolu dəyişdirin” xəbərdarlıq mesajını göstərən { -brand-name-firefox } parol menecerinin şəkli.
