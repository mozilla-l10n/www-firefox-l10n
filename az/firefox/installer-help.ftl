### URL: https://www-dev.springfield.moz.works/download/installer-help/


## Required

installer-help-page-title = Endirməniz kəsildi
installer-help-main-tagline = Bəzən belə hallar olur. Başqa bir yol yoxlayaq.
installer-help-action-channel = Bu endirmə sizin üçün daha yaxşı işləməlidir.
installer-help-action-choose = Aşağıdan bir endirmə seçin.

##

installer-help-firefox-release-title = { -brand-name-firefox-browser }
# Variables:
#   $trackers (number) - number of trackers blocked by Firefox (currently in the thousands)
installer-help-firefox-release-desc-v2 = Ən son versiyanı əldə edin. Avtomatik məxfilik artıq buradadır. { $trackers }-dən çox izləyicini əngəlləmək üçün { -brand-name-firefox }-u endirin.
installer-help-firefox-beta-title-v2 = { -brand-name-firefox } { -brand-name-beta }
installer-help-firefox-beta-desc = Çıxmaq üzrə olan özəllikləri ən stabil buraxılış öncəsi versiyada yoxlayın.
installer-help-firefox-developer-title-v2 = { -brand-name-firefox } { -brand-name-developer-edition }
installer-help-firefox-developer-desc = Təkcə tərtibatçılar üçün qurulmuş yeganə səyyahla yaradın, test edin, miqyaslandırın və daha çoxunu edin.
installer-help-firefox-nightly-title-v2 = { -brand-name-firefox } { -brand-name-nightly }
installer-help-firefox-nightly-desc = Gələcək nəsil internet səyyahımıza nəzər salın və onu ən yaxşı səyyah halına gətirməyimizə kömək edin.
installer-help-need-help = Quraşdırmada kömək lazımdır?
# Variables:
#   $url (url) - link to https://support.mozilla.org/kb/install-firefox-windows
installer-help-need-help-desc = Əgər hələ də quraşdırmaq üçün yardıma ehtiyacınız varsa, <a href="{ $url }">Dəstək bölməmizdəki təlimatı oxuyun.</a>
