# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-language-not-available = Dieser { -brand-name-firefox }-Download von { $partner } ist in deiner Sprache nicht verfügbar. Du kannst { -brand-name-firefox } trotzdem über den Button unten herunterladen.

# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-device-not-available = Dieser { -brand-name-firefox }-Download von { $partner } ist auf deinem Gerät nicht verfügbar. Du kannst { -brand-name-firefox } trotzdem über den Button unten herunterladen.

# firefox.com is a web address. Don’t translate it.
partner-download-already-using-firefox = Du nutzt { -brand-name-firefox } bereits. Weiter zu firefox.com für alle Neuigkeiten.

# firefox.com is a web address. Don’t translate it.
partner-download-continue = Weiter zu firefox.com

# Variables:
#   $partner (string) - a company name, e.g. Acme
