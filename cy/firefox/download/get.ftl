### URL: https://www-dev.springfield.moz.works/get/

# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-language-not-available = Dyw'r llwytho hwn o { -brand-name-firefox } gan { $partner } ddim ar gael yn eich iaith chi. Gallwch barhau i lwytho { -brand-name-firefox } i lawr gan ddefnyddio'r botwm isod.
# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-device-not-available = Dyw'r llwytho hwn o { -brand-name-firefox } gan { $partner } ddim ar gael ar gyfer eich dyfais chi. Gallwch barhau i lwytho { -brand-name-firefox } i lawr gan ddefnyddio'r botwm isod.
# firefox.com is a web address. Don’t translate it.
partner-download-already-using-firefox = Rydych chi eisoes yn defnyddio { -brand-name-firefox }. Ewch ymlaen i firefox.com i weld beth sy'n newydd.
# firefox.com is a web address. Don’t translate it.
partner-download-continue = Ymlaen i firefox.com
# Variables:
#   $partner (string) - a company name, e.g. Acme
# $partner is a company name and stays in its original form. If your language changes a name’s ending after ‘from’, rephrase the sentence so the name can stay unchanged.
partner-download-link-visit = Ymweld â { $partner }
# Button text for a link to a company’s page.
partner-download-link-learn-more = Dysgu rhagor
