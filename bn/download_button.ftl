download-button-download-now = ডাউনলোড করুন
download-button-firefox-beta = { -brand-name-firefox-beta }
download-button-firefox-aurora = { -brand-name-firefox-aurora }
download-button-firefox-developer-edition = <span>{ -brand-name-firefox }</span> { -brand-name-developer-edition }
download-button-firefox-nightly = { -brand-name-firefox-nightly }
download-button-systems-languages = সিস্টেম ও ভাষা
download-button-google-play = { -brand-name-google-play } থেকে ডাউনলোড করুন
download-button-download-app-store = { -brand-name-app-store } থেকে ডাউনলোড করুন
download-button-download-firefox = { -brand-name-firefox } ডাউনলোড করুন
download-button-your-system-may = আপনার সিস্টেম { -brand-name-firefox } এর প্রয়োজনীয়তার সাথে নাও মিলতে পারে, তবে আপনি এগুলোর মধ্যে অন্য যে কোন সংস্করণ চেষ্টা করতে পারেন:
download-button-firefox-beta-android = { -brand-name-android } এর জন্য <span>{ -brand-name-firefox-beta }</span>
download-button-firefox-aurora-android = { -brand-name-android } এর জন্য <span>{ -brand-name-firefox-aurora }</span>
download-button-firefox-nightly-android = { -brand-name-android } এর জন্য <span>{ -brand-name-firefox-nightly }</span>
download-button-firefox-android = { -brand-name-android } এর জন্য <span>{ -brand-name-firefox }</span>
download-button-firefox-ios = { -brand-name-ios } এর জন্য <span>{ -brand-name-firefox }</span>
download-button-firefox-privacy = { -brand-name-firefox } গোপনীয়তা
download-button-firefox-privacy-notice = { -brand-name-firefox } গোপনীয়তা বিজ্ঞপ্তি
download-button-download = ডাউনলোড
# Variables:
#   $channel_name (string) - e.g. Firefox Beta, Firefox Nightly
#   $help_url (url) - link to https://support.mozilla.org/
#   $os_version (string) - e.g. Windows 8.1, macOS 10.14
download-button-unsupported-platform = { $os_version } এবং তার নিচের সংস্করণগুলিতে { $channel_name } আর সাপোর্ট করবে না।
download-button-please-download-esr = { -brand-name-firefox } ব্যবহার করার জন্য অনুগ্রহ করে { -brand-name-firefox-esr } (এক্সটেন্ডেড সাপোর্ট রিলিজ) ডাউনলোড করুন।
download-firefox-esr = { -brand-name-firefox-esr } ডাউনলোড করুন
download-firefox-esr-32 = { -brand-name-firefox-esr } ডাউনলোড করুন ৩২-বিট
download-firefox-esr-64 = { -brand-name-firefox-esr } ডাউনলোড করুন ৬৪-বিট
download-a-different-build = অন্য একটি বিল্ড ডাউনলোড করুন

## Linux

