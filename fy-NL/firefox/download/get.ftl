partner-download-device-not-available = Dizze { -brand-name-firefox }-download fan { $partner } is net beskikber foar jo apparaat. Jo kinne { -brand-name-firefox } noch altyd downloade mei de knop hjirûnder.
# firefox.com is a web address. Don’t translate it.
partner-download-already-using-firefox = Jo brûke { -brand-name-firefox } al. Gean troch nei firefox.com om te sjen wat nij is.
# firefox.com is a web address. Don’t translate it.
partner-download-continue = Trochgean mei firefox.com
