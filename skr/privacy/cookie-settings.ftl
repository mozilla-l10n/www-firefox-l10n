cookie-settings-page-title = کوکی ترتیباں
cookie-settings-page-desc = ایہہ صفحہ Cookies دیاں مختلف قسماں بیان کریندا ہے جنھیں { -brand-name-mozilla } ورت سڳدا ہے، تے تساں کوں اے کنٹرول ݙیندا ہے کہ تساں { -brand-name-mozilla } کوں کہڑے قسم دے ڈیٹا اکٹھا کرݨ دی اجازت ݙیندے ہو۔
cookie-settings-breadcrumb-link = پچھلا ورقہ
cookie-settings-explainer = Cookies معلومات دے ٹکڑے رکھݨ آلیاں چھوٹیاں فائلاں ہن جنھیں تہاݙے کمپیوٹر یا ڈیوائس تے محفوظ کیتا ویندا ہے جڈاں تساں ہک ویب سائٹ تے ویندے ہو۔ { -brand-name-mozilla } ساݙیاں ویب سائٹاں کوں کم کرݨ وچ مدد ݙیوݨ کیتے، تے اے معلومات اکٹھی کرݨ کیتے کہ تساں ساݙیاں ویب سائٹاں کوں کیویں ورتیندے ہو تے انھاں نال کیویں پیش آندے ہو، جیویں او صفحے جنھیں تے تساں ویندے ہو، Cookies ورتیندا ہے۔
cookie-settings-page-intro-v2 = ایہہ صفحہ Cookies تے انھاں وانگوں دیاں ٹیکنالوجیاں دیاں مختلف قسماں بیان کریندا ہے، جیویں پکسل ٹیگز، ویب بیکنز، کلیئر GIFs، JavaScript، تے لوکل اسٹوریج (اڳوں، "Cookies") جنھیں { -brand-name-mozilla } ورت سڳدا ہے، تے تساں کوں اے کنٹرول ݙیندا ہے کہ تساں { -brand-name-mozilla } کوں کہڑے قسم دے ڈیٹا اکٹھا کرݨ دی اجازت ݙیندے ہو۔
cookie-settings-how-mozilla-heading = { -brand-name-mozilla } کین٘ویں کوکیاں ورتیندے
cookie-settings-how-does-mozilla-use-subheading = { -brand-name-mozilla } ایہ ڈیٹا کین٘ویں ورتیندے؟
cookie-settings-save-changes = تبدیلیاں محفوظ کرو
cookie-settings-your-cookie-settings-have = تہاݙیاں کوکی ترتیباں اپ ڈیٹ تھی ڳیاں۔
cookie-settings-i-agree = میں متفق ہاں
cookie-settings-i-do-not-agree = میں راضی کائنی
cookie-settings-turn-on-javascript = سوہݨا، آپݨیاں کوکی ترتیباں اپ ڈیٹ کرݨ کیتے جاوا سکرپٹ آن کرو۔

## Necessary cookies section

cookie-settings-category-necessary-heading = ضروری
cookie-settings-category-necessary-what-are-subheading = ضروری کوکیاں کیا ہن؟
cookie-settings-category-necessary-what-are-desc = ایہہ ٹیکنالوجیاں ویب سائٹ دے ضروری فیچرز کوں سپورٹ کرݨ کیتے ضروری ہن، جیویں ویب سائٹ دے محفوظ حصے وچ لاگ ان کرݨ یا آن لائن خریداری دی ٹوکری وچ شئیں شامل کرݨ، تے انھیں کوں بند نیں کیتا ونج سڳدا۔
cookie-settings-category-necessary-how-does-desc-v2 = { -brand-name-mozilla } ضروری Cookies صرف ویب سائٹ دے ضروری فیچرز ݙیوݨ کیتے ورتیندا ہے، جیویں تہاݙے { -brand-name-mozilla-account } نال لاگ ان کرݨ یا چیک آؤٹ تے سافٹ ویئر سبسکرپشن خریدݨ۔ انھاں ٹیکنالوجیاں دے بغیر، ویب سائٹ دے ضروری فیچرز کم نیں کر سڳدے۔

## Preference cookies section

cookie-settings-category-preference-heading = ترجیح
cookie-settings-category-preference-what-are-subheading = ترجیح کوکیاں کیا ہن؟
cookie-settings-category-preference-what-are-desc = ایہہ ٹیکنالوجیاں تساں دے او انتخاب یاد رکھݨ کیتے ورتیاں ویندین جنھیں تساں ویب سائٹ دے پچھلے دورے دوران کیتے ہن۔ مثالاں وچ شامل ہو سڳدا ہے کہ تساں کہڑی زبان وچ پڑھݨ پسند کریندے ہو، یا تہاݙا پسندیدہ رنگ تھیم کہڑا ہے۔
cookie-settings-category-preference-how-does-desc = { -brand-name-mozilla } تہاݙیاں ترجیحاں دا احترام کرݨ تے ساݙیاں ویب سائٹاں تے تہاݙے تجربے کوں بہتر بݨاوݨ کیتے Preference Cookies ورتیندا ہے۔ ایہہ تجزیاتی مقاصد کیتے نیں ورتے ویندے۔ Preference Cookies ضروری Cookies وانگوں فیچرز کوں سپورٹ کریندے ہن، پر ویب سائٹ انھاں دے بغیر وی چل سڳدی ہے۔ ایں کیتے، تساں انھاں دے استعمال توں آپٹ آؤٹ کرݨ دا انتخاب کر سڳدے ہو۔

## Analytics cookies section

cookie-settings-category-analytics-heading = تجزیاتی
cookie-settings-category-analytics-what-are-subheading = تجزیاتی کوکیاں کیا ہن؟
cookie-settings-category-analytics-what-are-desc = ایہہ ٹیکنالوجیاں لوک ویب سائٹاں کوں کیویں ورتیندے ہن، ایندے بارے وچ معلومات اکٹھیاں کریندین، جیویں وزٹ کیتے ڳئے صفحے، کلک کیتے ڳئے لنکس، تے او بیا ویب سائٹاں جنھیں توں وزٹس شروع تھئے ہن۔
cookie-settings-category-analytics-how-does-desc = { -brand-name-mozilla } تجزیاتی معلومات ایں کیتے ورتیندا ہے کہ ایہہ سمجھ سڳے کہ لوک ساݙیاں ویب سائٹاں کوں کیویں ورتیندے ہن، تاں جو اساں انھاں کوں بہتر بݨا سڳوں تے پیش آوݨ آلیاں مشکلاں دور کر سڳوں۔ اساں Cookies، ڈیوائس معلومات تے IP پتیاں توں ڈیٹا وی ورت سڳدے ہیں تاں جو اساں ایہہ سمجھ سڳوں کہ لوک ساݙیاں پراڈکٹس، سروسز، رابطیاں، ویب سائٹاں، آن لائن مہماں، ڈیوائساں تے بیا پلیٹ فارماں نال کیویں پیش آندے ہن۔ اساں صرف تہاݙی رضامندی نال تجزیاتی معلومات اکٹھیاں کریسوں تے Analytics Cookies سیٹ کریسوں۔

## Privacy section

cookie-settings-privacy-heading = ساݙا رازداری نوٹس
cookie-settings-privacy-desc = جڈاں تساں ساݙیاں ویب سائٹاں تے ویندے ہو تاں { -brand-name-mozilla } کہڑے قسم دیاں معلومات اکٹھیاں کریندا ہے، انھاں دے بارے وچ ودھیک تفصیلی معلومات کیتے تساں تھلے ساݙے رازداری نوٹس دا لنک ڳھول سڳدے ہو۔
cookie-settings-privacy-policy-link = رازداری نوٹس
