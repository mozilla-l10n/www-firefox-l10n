# HTML page description
pdf-editor-view-and-edit-pdf-files-right-in = پی ڈی ایف فائلاں  کوں { -brand-name-firefox } وچ سدھا ݙیکھو تے تبدیلی کرو۔
pdf-editor-if-you-need-to-add-stuff-to-a-pdf = ڄیکر تُہاکوں پی ڈی ایف دستاویز وِچ شئیں رَلاوݨ دی لوڑ ہِے، ہُݨ تُساں اِیکوں { -brand-name-firefox }دے نال آن لائن کر سڳدے ہِیوے۔ پی ڈی ایف کوں { -brand-name-firefox }وِچ کھولو اَتے آپݨی دستاویز وِچ بَدلیاں کرݨ کِیتے اُتلی سَڄّی نُکّڑ وِچ متن یا ڈرا بٹݨ اُتے دباؤ۔ فائل کوں آپݨیاں بدلیاں دے نال محفوظ کرݨ کِیتے ڈاؤن لوڈ کرو۔
pdf-editor-fill-in-forms-online-without = پرنٹنگ تے سکیننگ دے بغیر آن لائن فارم پُر کرو
pdf-editor-weve-all-faced-this-you-need-to = اَساں ساریاں اِین٘دا سامھݨاں کِیتا ہِے: تُہاکوں ہِک اِین٘جھا فارم پُر کرݨ دی لوڑ ہِے جہڑا پی ڈٰ ایف ہووے، پَر اِیہ ترمیم دے قابل کائنی۔ پِچھوکڑ وِچ، تُہاݙا کَلّھا چوݨ اِیہ ہَئی جو اِیکوں موئے ہوئے وَݨ اُتّے چھاپو، سیاہی نال شئیں رلاؤ، اَتے وَل اِیکوں آپݨے کمپیوٹر وِچ وَلا سکین کرو۔
pdf-editor-no-more-now-all-you-need-to-do = ٻس! ہُݨ، تُہاکوں ٻس پی ڈی ایف وِچ آن لائن ترمیم کرݨ دی لوڑ ہِے { -brand-name-firefox }دے نال، اِیکوں محفوظ کرو، اَتے اِیکوں آپݨے کمپیوٹر نال ای میل کرو۔
pdf-editor-add-text = عبارت شامل کرو
pdf-editor-open-the-pdf-in-firefox-click-text = پی ڈی ایف کوں { -brand-name-firefox } وِچ کھولو۔ جین٘دے وِچ دستاویز وِچ تُساں متن رلاوݨاں چاہن٘دے ہِیوے اِیکوں چُݨن کنوں پہلاں رنگ اَتے متن دا سائز چُݨن کِیتے ٹیکسٹ بٹݨ اُتے دباؤ۔ اِیہ ایݙا سَوکھا ہِے!
pdf-editor-add-drawings = ڈرائنگز شامل کرو
pdf-editor-open-the-pdf-in-firefox-click-draw-to-choose = PDF کوں { -brand-name-firefox } وچ کھولو۔ دستاویز تے ڈرائنگ کرݨ توں پہلے رنگ، موٹائی تے شفافیت چݨݨ کیتے Draw آئیکون تے کلک کرو۔
pdf-editor-add-image-with-alt-text = آلٹ عبارت نال تصویر شامل کرو
pdf-editor-open-pdf-click-image-icon = پی ڈی ایف کوں { -brand-name-firefox } وِچ کھولو۔ تصویر دے آئیکن اُتے دباؤ، جہڑا وَل تُہاکوں تصویر اَپ لوڈ کرݨ دا اشارہ کریسی۔ لوڑ مطابق آپݨی تصویر دے سائز اَتے جاء کوں مُرتّب کرو۔ آپݨی پی ڈی ایف کوں ٻِیا رسائی دے قابل بݨاوݨ کِیتے تصویر دی تفصیل رلاوݨ کِیتے تصویر اُتے موجود "Alt text" بٹݨ اُتے دباؤ۔
pdf-editor-create-a-highlight = ہک ہائی لائٹ بݨاؤ
pdf-editor-select-text-you-want-to = پی ڈی ایف کوں { -brand-name-firefox } وِچ کھولو۔ اُوہ متن چُݨو جیکوں تُساں نُمایاں کرݨاں چاہن٘دے ہِیوے، وَل تُہاݙی چوݨ دے تلّے ظاہر تِھیوݨ آلے ہائی لائٹ آئیکن اُتّے دباؤ، یا سیاق و سباق دے مینیو وِچ ہائی لائٹ چوݨ لبّھݨ کِیتے سَڄّا بٹݨ دباؤ۔ پی ڈی ایف دے سیکشنز کوں فری ہینڈ ہائی لائٹ کرݨ کِیتے اُتّے سَڄّے پاسے آئیکن اُتے دباؤ۔
pdf-editor-create-a-signature = دستخط بݨاؤ
pdf-editor-click-the-signature-icon = PDF کوں { -brand-name-firefox } وچ کھولو۔ دستخط آئیکون تے کلک کرو تے ول “Add new signature” تے کلک کرو۔ Type، Draw یا Image وچوں چݨو، تے شامل کرݨ کیتے Add بٹن تے کلک کرو۔ تساں اپݨے دستخطاں کوں محفوظ وی کر سڳدے ہو تے بعد وچ انہاں کوں ولا استعمال کر سڳدے ہو۔
pdf-editor-add-a-comment = تبصرے شامل کرو
pdf-editor-click-the-comment-icon = PDF کوں { -brand-name-firefox } وچ کھولو۔ ہائی لائٹ بݨاؤ، ول تہاݙی چݨاو دے تلے نظر آوݨ آلا Comment آئیکون تے کلک کرو، اپݨا تبصرہ لکھو تے محفوظ کرݨ کیتے Add تے کلک کرو۔ PDF وچ ٻہوں سارے تبصرے ہن؟ سائیڈ بار کھولݨ تے اپݨے مطلوب تبصرے تے ونڄݨ کیتے اُتے سڄے پاسے Comment آئیکون تے کلک کرو۔
